# Copy to wrangler.toml (do not commit the real file with production IDs if you
# prefer to keep them local) and replace the KV namespace id.
#
#   cd api
#   cp wrangler.toml.example wrangler.toml
#   npx wrangler kv namespace create NICKEY_TRIPS
#   # paste the printed id below
#   npx wrangler secret put BOT_API_KEY
#   npx wrangler secret put GEMINI_API_KEY   # optional
#   npx wrangler deploy

name = "nickey-bot-api"
main = "src/index.js"
compatibility_date = "2026-09-06"

[[kv_namespaces]]
binding = "NICKEY_TRIPS"
id = "REPLACE_WITH_KV_NAMESPACE_ID"
# preview_id = "REPLACE_WITH_PREVIEW_KV_ID"   # optional, for wrangler dev --remote

# Secrets (wrangler secret put) — do not put real values here:
#   BOT_API_KEY       required — Bearer / X-Api-Key
#   GEMINI_API_KEY    optional — fills empty heuristic fields on from-dispatch-text
